{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Verbeo",
  "theme": "luma",
  "favicon": "/logo/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "colors": {
    "primary": "#4464fc"
  },
  "api": {
    "mdx": {
      "server": "https://api.verbeo.ai/v1",
      "auth": {
        "method": "bearer"
      }
    },
    "playground": {
      "display": "interactive"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@verbeo.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.verbeo.ai"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/api-reference/overview"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/overview",
              "api-reference/authentication",
              "api-reference/responses",
              "api-reference/errors"
            ]
          },
          {
            "group": "Calls",
            "icon": "phone-volume",
            "pages": [
              "api-reference/calls/initiate"
            ]
          },
          {
            "group": "Campaigns",
            "pages": [
              "api-reference/campaigns/overview",
              "api-reference/campaigns/list",
              "api-reference/campaigns/create",
              "api-reference/campaigns/get",
              "api-reference/campaigns/update",
              "api-reference/campaigns/delete",
              "api-reference/campaigns/pause",
              "api-reference/campaigns/resume",
              "api-reference/campaigns/stats"
            ]
          },
          {
            "group": "Webhooks",
            "icon": "bolt",
            "pages": [
              "api-reference/webhooks/events",
              "api-reference/webhooks/tool-calls"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Phone Numbers",
            "icon": "phone",
            "pages": [
              "guides/import-twilio-number"
            ]
          },
          {
            "group": "Web Widget",
            "icon": "code",
            "pages": [
              "guides/web-widget"
            ]
          },
          {
            "group": "Call data",
            "icon": "chart-bar",
            "pages": [
              "concepts/calls",
              "guides/post-call-analysis",
              "guides/webhooks"
            ]
          }
        ]
      }
    ]
  }
}
